                    "edgeIds": []
                },
                "95ad0808-c88b-4a40-a2a6-8fef1ebaf6c9": {
                    "name": "func_code",
                    "value": "def build_row(bin_key):\n    key, count = bin_key\n    mag_bin, colour_bin, mag_min, colour_min, mag_size, colour_size = key\n    return {\n        \"mag_bin\": mag_bin,\n        \"colour_bin\": colour_bin,\n        \"mag_centre\": round(mag_min + (mag_bin + 0.5) * mag_size, 6),\n        \"colour_centre\": round(colour_min + (colour_bin + 0.5) * colour_size, 6),\n        \"count\": count,\n    }",
                    "defaultValue": "def build_row(bin_key):\n    key, count = bin_key\n    mag_bin, colour_bin, mag_min, colour_min, mag_size, colour_size = key\n    return {\n        \"mag_bin\": mag_bin,\n        \"colour_bin\": colour_bin,\n        \"mag_centre\": round(mag_min + (mag_bin + 0.5) * mag_size, 6),\n        \"colour_centre\": round(colour_min + (colour_bin + 0.5) * colour_size, 6),\n        \"count\": count,\n    }",
