            "fields": {
                "1d972931-4c54-48b1-a73e-337ed3016c7e": {
                    "name": "func_name",
                    "value": "build_row",
                    "defaultValue": "build_row",
                    "description": "Python function name",
                    "readonly": false,
                    "type": "String",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
