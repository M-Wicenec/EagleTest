                "04727e27-6f39-495e-ab97-ac65b3b9e67d": {
                    "name": "func_code",
                    "value": "import csv\n\ndef write_rows(rows, path):\n    with open(path, \"w\", newline=\"\") as fh:\n        writer = csv.DictWriter(\n            fh,\n            fieldnames=[\"mag_bin\", \"colour_bin\", \"mag_centre\", \"colour_centre\", \"count\"],\n        )\n        writer.writeheader()\n        writer.writerows(rows)\n    return len(rows)",
                    "defaultValue": "import csv\n\ndef write_rows(rows, path):\n    with open(path, \"w\", newline=\"\") as fh:\n        writer = csv.DictWriter(\n            fh,\n            fieldnames=[\"mag_bin\", \"colour_bin\", \"mag_centre\", \"colour_centre\", \"count\"],\n        )\n        writer.writeheader()\n        writer.writerows(rows)\n    return len(rows)",
                    "description": "Python function code",
                    "readonly": false,
                    "type": "Python",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
