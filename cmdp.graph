                    "name": "func_name",
                    "value": "build_row",
                    "defaultValue": "build_row",
                    "description": "Python function name",
                    "readonly": false,
                    "type": "String",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
