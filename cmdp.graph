            "fields": {
                "04214fb4-dfe4-4bd3-b31b-5ceb5484b311": {
                    "name": "func_name",
                    "value": "compute_bin",
                    "defaultValue": "compute_bin",
                    "description": "Python function name",
                    "readonly": false,
                    "type": "String",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
                    "id": "04214fb4-dfe4-4bd3-b31b-5ceb5484b311",
                    "parameterType": "Component",
                    "usage": "NoPort",
                    "edgeIds": []
                },
                "2e0f2770-a5f1-4554-82a5-30e5e5c76e92": {
                    "name": "func_code",
                    "value": "import math\n\ndef compute_bin(rows):\n    out = []\n    for row in rows:\n        mag_bin = math.floor((row[\"vmag\"] - row[\"mag_min\"]) / row[\"mag_bin_size\"])\n        colour_bin = math.floor((row[\"bv\"] - row[\"colour_min\"]) / row[\"colour_bin_size\"])\n        out.append((\n            mag_bin,\n            colour_bin,\n            row[\"mag_min\"],\n            row[\"colour_min\"],\n            row[\"mag_bin_size\"],\n            row[\"colour_bin_size\"],\n        ))\n    return out",
                    "defaultValue": "import math\n\ndef compute_bin(rows):\n    out = []\n    for row in rows:\n        mag_bin = math.floor((row[\"vmag\"] - row[\"mag_min\"]) / row[\"mag_bin_size\"])\n        colour_bin = math.floor((row[\"bv\"] - row[\"colour_min\"]) / row[\"colour_bin_size\"])\n        out.append((\n            mag_bin,\n            colour_bin,\n            row[\"mag_min\"],\n            row[\"colour_min\"],\n            row[\"mag_bin_size\"],\n            row[\"colour_bin_size\"],\n        ))\n    return out",
                    "description": "Python function code",
                    "readonly": false,
                    "type": "Python",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
                    "id": "2e0f2770-a5f1-4554-82a5-30e5e5c76e92",
