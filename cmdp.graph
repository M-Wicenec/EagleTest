            "fields": {
                "3cae4853-b91f-432c-8f2e-fd7951036f53": {
                    "name": "func_name",
                    "value": "compute_bin",
                    "defaultValue": "compute_bin",
                    "description": "Python function name",
                    "readonly": false,
                    "type": "String",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
