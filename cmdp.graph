            "fields": {
                "c0040dc6-80d2-4081-b6a4-8df30ae4ace3": {
                    "name": "func_name",
                    "value": "compute_bin",
                    "defaultValue": "compute_bin",
                    "description": "Python function name",
                    "readonly": false,
                    "type": "String",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
