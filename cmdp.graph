                "e942b5b3-6322-4b7a-9093-b094a932e3ad": {
                    "name": "func_code",
                    "value": "def summarise(rows):\n    return {\n        \"bins_occupied\": len(rows),\n        \"stars_in_bins\": sum(r[\"count\"] for r in rows),\n    }",
