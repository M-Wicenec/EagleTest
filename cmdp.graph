        "9f0fa1ef-0001-40c6-90c7-af79eecaa537": {
            "category": "PyFuncApp",
            "categoryType": "Application",
            "id": "9f0fa1ef-0001-40c6-90c7-af79eecaa537",
            "name": "filter_stars",
            "description": "Python function application",
            "x": 350,
            "y": 200,
            "repositoryUrl": "",
            "commitHash": "",
            "paletteDownloadUrl": "",
            "dataHash": "",
            "parentId": null,
            "embedId": null,
            "fields": {
                "f65a2884-8c28-4d5f-aab7-c6c4c0a858fb": {
                    "name": "func_name",
                    "value": "filter_stars",
                    "defaultValue": "filter_stars",
                    "description": "Python function name",
                    "readonly": false,
                    "type": "String",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
                    "id": "f65a2884-8c28-4d5f-aab7-c6c4c0a858fb",
                    "parameterType": "Component",
                    "usage": "NoPort",
                    "edgeIds": []
                },
                "3bbb9c36-9e99-422a-8451-9a63194312f3": {
                    "name": "func_code",
                    "value": "def filter_stars(rows, params):\n    mag_min = params[\"mag_min\"]\n    mag_max = params[\"mag_max\"]\n    colour_min = params[\"colour_min\"]\n    colour_max = params[\"colour_max\"]\n    mag_size = params[\"mag_bin_size\"]\n    colour_size = params[\"colour_bin_size\"]\n    kept = []\n    for row in rows:\n        try:\n            vmag = float(row[\"vmag\"])\n            bv = float(row[\"bv\"])\n        except (TypeError, ValueError, KeyError):\n            continue\n        if mag_min <= vmag <= mag_max and colour_min <= bv <= colour_max:\n            kept.append({\n                \"hip\": row[\"hip\"],\n                \"vmag\": vmag,\n                \"bv\": bv,\n                \"mag_min\": mag_min,\n                \"colour_min\": colour_min,\n                \"mag_bin_size\": mag_size,\n                \"colour_bin_size\": colour_size,\n            })\n    return kept",
                    "defaultValue": "def filter_stars(rows, params):\n    mag_min = params[\"mag_min\"]\n    mag_max = params[\"mag_max\"]\n    colour_min = params[\"colour_min\"]\n    colour_max = params[\"colour_max\"]\n    mag_size = params[\"mag_bin_size\"]\n    colour_size = params[\"colour_bin_size\"]\n    kept = []\n    for row in rows:\n        try:\n            vmag = float(row[\"vmag\"])\n            bv = float(row[\"bv\"])\n        except (TypeError, ValueError, KeyError):\n            continue\n        if mag_min <= vmag <= mag_max and colour_min <= bv <= colour_max:\n            kept.append({\n                \"hip\": row[\"hip\"],\n                \"vmag\": vmag,\n                \"bv\": bv,\n                \"mag_min\": mag_min,\n                \"colour_min\": colour_min,\n                \"mag_bin_size\": mag_size,\n                \"colour_bin_size\": colour_size,\n            })\n    return kept",
                    "description": "Python function code",
                    "readonly": false,
                    "type": "Python",
                    "precious": false,
                    "options": [],
                    "positional": false,
                    "changeable": false,
                    "encoding": "pickle",
                    "id": "3bbb9c36-9e99-422a-8451-9a63194312f3",
                    "parameterType": "Component",
                    "usage": "NoPort",
                    "edgeIds": []
                },
